# Trading App Environment Configuration
# Copy this file to .env and update with your actual values

# Currency Settings
BASE_CURRENCY=USD
CONVERSION_CURRENCY=INR

# Initial Wallet Balance for New Users (in USD)
INITIAL_WALLET_BALANCE=1000.0

# App Settings
APP_NAME=Trading App
APP_VERSION=1.0.1

# API Keys (Get your own from https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY="M856UB65N7IOCGDM"

# Enable yfinance for stock data
YFINANCE_ENABLED=true

# Streamlit Configuration
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
